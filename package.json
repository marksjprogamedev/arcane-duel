{
  "name": "arcane-duel",
  "version": "0.8.0-0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "tsc -p tsconfig.server.json && node dist/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check-version": "node scripts/check-version.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write .",
    "test:smoke": "node tests/smoke.mjs",
    "postinstall": "npm run build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
